<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniLyrics.Gui.ConfigurationEditorWindow" Title="OmniLyrics" Icon="/Assets/app.ico"
        Width="780" Height="660" MinWidth="540" MinHeight="420" Topmost="True"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource PrimaryText}" WindowStartupLocation="CenterOwner">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="{DynamicResource EditConfiguration}" FontSize="24" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,18">
            <TextBlock Text="{DynamicResource ConfigurationEditorHint}" TextWrapping="Wrap" Opacity="0.65" />
            <TextBlock x:Name="ConfigurationPath" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBox x:Name="ConfigurationText" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="monospace" FontSize="14" CornerRadius="12" Padding="16"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource ErrorText}" />
            <Button Grid.Column="1" Content="{DynamicResource ReloadConfiguration}" Click="ReloadButton_Click" CornerRadius="8" Padding="16,10" />
            <Button Grid.Column="2" Content="{DynamicResource ApplySettings}" Click="SaveButton_Click" Background="{DynamicResource AccentFillBrush}" Foreground="{DynamicResource AccentForeground}" CornerRadius="8" Padding="20,10" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>
