<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OmniLyrics.Gui.SettingsWindow" Icon="/Assets/app.ico" Title="OmniLyrics" Width="980" Height="760" MinWidth="790" MinHeight="580" Topmost="True" Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource PrimaryText}" SystemDecorations="BorderOnly" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Window.Resources>
        <ControlTheme x:Key="SettingsSpinner" TargetType="ButtonSpinner">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SpinnerFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,32,32">
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            <RepeatButton x:Name="PART_IncreaseButton" Grid.Column="1" Width="32" MinWidth="0" Padding="0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="0" IsTabStop="{TemplateBinding IsTabStop}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <PathIcon Width="12" Height="7" Data="M0 6L6 0L12 6L11 7L6 2L1 7Z"/>
                            </RepeatButton>
                            <RepeatButton x:Name="PART_DecreaseButton" Grid.Column="2" Width="32" MinWidth="0" Padding="0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Background="Transparent" Foreground="{DynamicResource PrimaryText}" CornerRadius="0" IsTabStop="{TemplateBinding IsTabStop}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <PathIcon Width="12" Height="7" Data="M0 1L1 0L6 5L11 0L12 1L6 7Z"/>
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="Theme" Value="{StaticResource SettingsSpinner}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch:focus, TextBox#SettingsSearch:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch:pointerover:not(:focus) /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch:focus /template/ TextBlock#PART_Watermark, TextBox#SettingsSearch:pointerover /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus, NumericUpDown /template/ TextBox#PART_TextBox:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox#SettingsSearch /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="196"/>
            <Setter Property="Width" Value="196"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem PathIcon.navIcon">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="TabItem:selected PathIcon.navIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Width="6" MinHeight="24" HorizontalAlignment="Center">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{DynamicResource ScrollbarBrush}" CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto">
        <Border Width="232" HorizontalAlignment="Left" Background="{DynamicResource SidebarBackground}" Grid.RowSpan="2"/>
        <Grid Margin="18,26,18,0" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="208,*">
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="SettingsLogo" Source="/Assets/AppIcon.iconset/icon_128x128.png" Width="38" Height="38" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="OmniLyrics" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Settings}" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7" Margin="30,2,24,18">
                    <TextBlock x:Name="PageTitle" Text="{DynamicResource General}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="{DynamicResource GeneralSubtitle}" Classes="hint"/>
                </StackPanel>
            </Grid>
            <Border x:Name="SearchBoxHost" Grid.Row="1" ZIndex="1" Width="196" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" Background="{DynamicResource FieldBackground}" Margin="0,12,0,0" PointerPressed="SearchBoxHost_PointerPressed">
                <TextBox x:Name="SettingsSearch" Watermark="{DynamicResource SearchSettings}" CornerRadius="9" VerticalContentAlignment="Center" Padding="0,7,8,7" TextChanged="SettingsSearch_TextChanged">
                    <TextBox.InnerLeftContent>
                        <PathIcon x:Name="SearchIcon" IsHitTestVisible="False" Width="14" Height="14" Margin="10,0,8,0" Foreground="{DynamicResource SecondaryText}" Data="M10 2a8 8 0 1 0 4.9 14.3L21 22l1-1-5.7-6.1A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Border>
            <TextBlock x:Name="SearchEmpty" Grid.Row="1" IsVisible="False" Margin="240,68,0,0" Text="{DynamicResource NoSettingsFound}" Classes="hint"/>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="SettingsTabs_SelectionChanged">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="0,64,0,0"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabItem x:Name="GeneralTab" Tag="General Language SystemLanguage UiScale SystemScale CustomScale DPI HiDPI 缩放">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M3 4h18v2H3zm0 7h18v2H3zm0 7h18v2H3zM7 2h3v6H7zm8 7h3v6h-3zm-9 7h3v6H6z"/>
                            <TextBlock Text="{DynamicResource General}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel Spacing="18" Margin="0,16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="LanguageMode" Grid.Column="1" Width="180" SelectionChanged="LanguageMode_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource SystemLanguage}"/>
                                            <ComboBoxItem Content="简体中文"/>
                                            <ComboBoxItem Content="English"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="16" Margin="0,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource UiScale}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="UiScaleMode" Grid.Column="1" Width="180" SelectionChanged="UiScaleMode_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource SystemScale}"/>
                                            <ComboBoxItem Content="100%"/>
                                            <ComboBoxItem Content="125%"/>
                                            <ComboBoxItem Content="150%"/>
                                            <ComboBoxItem Content="175%"/>
                                            <ComboBoxItem Content="200%"/>
                                            <ComboBoxItem Content="{DynamicResource CustomScale}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid x:Name="CustomScaleRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                        <TextBlock Text="{DynamicResource UiScalePercent}" VerticalAlignment="Center"/>
                                        <NumericUpDown x:Name="CustomUiScale" Grid.Column="1" Width="144" Minimum="75" Maximum="300" Increment="5" FormatString="0.##" Value="100" ValueChanged="CustomUiScale_ValueChanged"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource UiScaleHint}" Classes="hint"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AppearanceTab" Tag="Appearance Preset FontSize TranslationFontSize BackgroundOpacity UseBlur ShowTranslation ShowLogo ShowPlayerInfo LockWindow ApproximateHighlight 字体 bilingual">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M3 3h18v18H3V3zm2 2v14h4V5H5zm6 0v14h8V5h-8z"/>
                            <TextBlock Text="{DynamicResource Appearance}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource Preset}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="PresetMode" Grid.Column="1" Width="228">
                                            <ComboBoxItem Content="{DynamicResource ClassicPreset}"/>
                                            <ComboBoxItem Content="{DynamicResource CompactPreset}"/>
                                            <ComboBoxItem Content="{DynamicResource FocusPreset}"/>
                                            <ComboBoxItem Content="{DynamicResource PortraitPreset}"/>
                                            <ComboBoxItem Content="{DynamicResource FullscreenPreset}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource FontSize}"/>
                                        </StackPanel>
                                        <NumericUpDown x:Name="LyricFontSize" Grid.Column="1" Minimum="16" Maximum="72" Increment="1" FormatString="0" Width="128"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource TranslationFontSize}"/>
                                        </StackPanel>
                                        <NumericUpDown x:Name="TranslationSize" Grid.Column="1" Minimum="12" Maximum="40" Increment="1" FormatString="0" Width="128"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource BackgroundOpacity}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Width="146" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" Width="38" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource UseBlur}"/>
                                            <TextBlock Text="{DynamicResource BlurExplanation}" Classes="hint"/>
                                            <TextBlock x:Name="MacBlurOpacityHint" Text="{DynamicResource MacBlurOpacityHint}" Classes="hint" IsVisible="False"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="BlurMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource ShowTranslation}"/>
                                            <TextBlock Text="{DynamicResource TranslationExplanation}" Classes="hint"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="TranslationMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource ShowLogo}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ShowLogoMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource ShowPlayerInfo}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ShowPlayerMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource LockWindow}"/>
                                            <TextBlock Text="{DynamicResource LockExplanation}" Classes="hint"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LockedMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource ApproximateHighlight}"/>
                                            <TextBlock Text="{DynamicResource ApproximateExplanation}" Classes="hint"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ApproximateMode" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button Classes="action" Content="{DynamicResource ResetAppearance}" Click="ResetAppearanceButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ThemeTab" Tag="ThemeColors ThemePreset ThemeMode AccentColor TextColor HighlightColor BackgroundColor SaveThemePreset DarkTheme LightTheme theme palette 主题 配色 预设">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M12 2a10 10 0 1 0 0 20h2a3 3 0 0 0 0-6h-1a1 1 0 0 1 0-2h3a6 6 0 0 0 0-12zM6 8a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm7-2a2 2 0 1 1 4 0 2 2 0 0 1-4 0z"/>
                            <TextBlock Text="{DynamicResource ThemeColors}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel Spacing="12" Margin="0,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource ThemePreset}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ThemePresetMode" Grid.Column="1" Width="210" SelectionChanged="ThemePresetMode_SelectionChanged"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource ThemePresetExplanation}" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <TextBlock Text="{DynamicResource ThemeMode}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ThemeMode" Grid.Column="1" Width="160" SelectionChanged="ThemeMode_Changed">
                                            <ComboBoxItem Content="{DynamicResource DarkTheme}"/>
                                            <ComboBoxItem Content="{DynamicResource LightTheme}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <TextBlock Text="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                                        <ColorPicker x:Name="AccentColorPicker" Grid.Column="1" IsAlphaEnabled="False" Width="56" Height="32" ColorChanged="ThemeColor_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <TextBlock Text="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                        <ColorPicker x:Name="TextColorPicker" Grid.Column="1" IsAlphaEnabled="False" Width="56" Height="32" ColorChanged="ThemeColor_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <TextBlock Text="{DynamicResource HighlightColor}" VerticalAlignment="Center"/>
                                        <ColorPicker x:Name="HighlightColorPicker" Grid.Column="1" IsAlphaEnabled="False" Width="56" Height="32" ColorChanged="ThemeColor_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,14">
                                        <TextBlock Text="{DynamicResource BackgroundColor}" VerticalAlignment="Center"/>
                                        <ColorPicker x:Name="BackgroundColorPicker" Grid.Column="1" IsAlphaEnabled="False" Width="56" Height="32" ColorChanged="ThemeColor_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="12" Margin="0,14">
                                    <TextBlock Text="{DynamicResource SaveThemePreset}" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox x:Name="ThemePresetName" Watermark="{DynamicResource ThemeName}" MaxLength="64" VerticalContentAlignment="Center" Height="36" Margin="0,0,10,0"/>
                                        <Button Classes="action" Grid.Column="1" x:Name="SaveThemeButton" Content="{DynamicResource SavePreset}" Click="SaveThemePreset_Click"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource ThemeSaveHint}" Classes="hint"/>
                                    <Button Classes="action" x:Name="DeleteThemeButton" Content="{DynamicResource DeleteThemePreset}" HorizontalAlignment="Left" IsVisible="False" Click="DeleteThemePreset_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="PlayerConnectionsTab" Tag="PlayerConnections CiderOptions Integration TokenMode NoTokenMode FavoritesAccess Spotify Apple Music YesPlayMusic YesPlayMusicConnectionTitle AuthorizeYesPlayMusic NetEase 网易云 扫码 登录 Client ID QR token 收藏 授权 二维码">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M7 2h2v6h6V2h2v6h3v3a8 8 0 0 1-7 8v4h-2v-4a8 8 0 0 1-7-8V8h3zm-1 8v1a6 6 0 0 0 12 0v-1z"/>
                            <TextBlock Text="{DynamicResource PlayerConnections}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel Spacing="18" Margin="0,16">
                                    <TextBlock Text="{DynamicResource CiderOptions}" Classes="section"/>
                                    <TextBlock Text="{DynamicResource PlayerConnectionExplanation}" Classes="hint"/>
                                    <TextBlock Text="{DynamicResource Integration}"/>
                                    <ComboBox x:Name="IntegrationMode" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource AutoIntegration}"/>
                                        <ComboBoxItem Content="{DynamicResource WebApiIntegration}"/>
                                        <ComboBoxItem Content="{DynamicResource MprisIntegration}"/>
                                    </ComboBox>
                                    <RadioButton x:Name="TokenMode" GroupName="Authentication" Content="{DynamicResource TokenMode}"/>
                                    <RadioButton x:Name="NoTokenMode" GroupName="Authentication" Content="{DynamicResource NoTokenMode}"/>
                                    <TextBox x:Name="TokenInput" PasswordChar="●" RevealPassword="False" IsEnabled="{Binding IsChecked, ElementName=TokenMode}" Watermark="{DynamicResource EnterToken}" MaxLength="4096"/>
                                    <TextBlock Text="{DynamicResource FavoritesAccess}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                                    <TextBlock x:Name="OverrideNotice" IsVisible="False" TextWrapping="Wrap" Text="{DynamicResource EnvironmentOverride}" Foreground="{DynamicResource WarningText}"/>
                                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="48"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                        <Button Classes="action" x:Name="TestButton" Content="{DynamicResource TestCider}" Click="TestButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" x:Name="AppleMusicFavoritesCard" IsVisible="False">
                                <StackPanel Spacing="12" Margin="0,16">
                                    <TextBlock Text="Apple Music" Classes="section"/>
                                    <TextBlock Text="{DynamicResource AppleMusicFavoritesHint}" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="12" Margin="0,16">
                                    <TextBlock Text="Spotify" Classes="section"/>
                                    <TextBlock Text="{DynamicResource SpotifyFavoritesHint}" Classes="hint"/>
                                    <TextBlock Text="Client ID"/>
                                    <TextBox x:Name="SpotifyClientIdInput" MaxLength="256" Watermark="Spotify Client ID"/>
                                    <TextBlock Text="{DynamicResource SpotifyRedirectHint}" Classes="hint"/>
                                    <SelectableTextBlock Text="http://127.0.0.1/spotify/callback" FontSize="12" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <Button Classes="action" x:Name="SpotifySignInButton" Content="{DynamicResource AuthorizeSpotify}" Click="SpotifySignIn_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="SpotifyCancelButton" IsVisible="False" Content="{DynamicResource Cancel}" Click="SpotifyCancel_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" Content="{DynamicResource DisconnectAccount}" Click="SpotifyDisconnect_Click" Margin="0,0,10,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="SpotifyLoginStatus" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" x:Name="YesPlayMusicCard">
                                <StackPanel Spacing="12" Margin="0,16">
                                    <TextBlock Text="{DynamicResource YesPlayMusicConnectionTitle}" Classes="section"/>
                                    <TextBlock Text="{DynamicResource YesPlayMusicFavoritesHint}" Classes="hint"/>
                                    <Border x:Name="YesPlayMusicQrPanel" IsVisible="False" Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Left">
                                        <Image x:Name="YesPlayMusicQr" Width="200" Height="200" Stretch="Uniform"/>
                                    </Border>
                                    <WrapPanel>
                                        <Button Classes="action primary" x:Name="YesPlayMusicSignInButton" Content="{DynamicResource AuthorizeYesPlayMusic}" Click="YesPlayMusicSignIn_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="YesPlayMusicCheckButton" Content="{DynamicResource YesPlayMusicCheckAuthorization}" Click="YesPlayMusicCheck_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="YesPlayMusicCancelButton" IsVisible="False" Content="{DynamicResource Cancel}" Click="YesPlayMusicCancel_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="YesPlayMusicDisconnectButton" IsVisible="False" Content="{DynamicResource DisconnectAccount}" Click="YesPlayMusicDisconnect_Click" Margin="0,0,10,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="YesPlayMusicLoginStatus" Classes="hint"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="LyricsTab" Tag="LyricsMatching SearchStrategy MatchMode BalancedMatch StrictMatch QuickSearch FallbackSearch LyricsSources PreferredLyricSource QQMusic Netease PlayerLyrics KaraokeFirst Prefetch UpcomingTracks 歌词 搜索 匹配 来源 缓存 cache">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M4 4h16v2H4zm0 7h11v2H4zm0 7h8v2H4zM18 10v8.2a3 3 0 1 0 2 2.8v-7h3v-4z"/>
                            <TextBlock Text="{DynamicResource LyricsMatching}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel Spacing="18" Margin="0,16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource SearchStrategy}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="SearchStrategyMode" Grid.Column="1" Width="205" AutomationProperties.Name="{DynamicResource SearchStrategy}">
                                            <ComboBoxItem Content="{DynamicResource FallbackSearch}"/>
                                            <ComboBoxItem Content="{DynamicResource QuickSearch}"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource SearchStrategyExplanation}" Classes="hint"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource MatchMode}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MatchMode" Grid.Column="1" Width="205" AutomationProperties.Name="{DynamicResource MatchMode}">
                                            <ComboBoxItem Content="{DynamicResource BalancedMatch}"/>
                                            <ComboBoxItem Content="{DynamicResource StrictMatch}"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource MatchModeExplanation}" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="18" Margin="0,16">
                                    <TextBlock Text="{DynamicResource LyricsSources}" Classes="section"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource PlayerLyrics}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="PlayerLyricsEnabled" Grid.Column="1" AutomationProperties.Name="{DynamicResource PlayerLyrics}"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource PlayerLyricsExplanation}" Classes="hint"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource QQMusic}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="QQLyricsEnabled" Grid.Column="1" AutomationProperties.Name="{DynamicResource QQMusic}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource Netease}" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="NeteaseLyricsEnabled" Grid.Column="1" AutomationProperties.Name="{DynamicResource Netease}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource PreferredLyricSource}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="PreferredLyricSourceMode" Grid.Column="1" Width="205" AutomationProperties.Name="{DynamicResource PreferredLyricSource}">
                                            <ComboBoxItem Content="{DynamicResource QQMusic}"/>
                                            <ComboBoxItem Content="{DynamicResource Netease}"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource LyricsSourcesExplanation}" Classes="hint"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="18" Margin="0,16">
                                    <TextBlock Text="{DynamicResource KaraokeFirst}" Classes="section"/>
                                    <TextBlock Text="{DynamicResource KaraokeExplanation}" Classes="hint"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="5" Margin="0,0,18,0">
                                            <TextBlock Text="{DynamicResource Prefetch}"/>
                                            <TextBlock Text="{DynamicResource PrefetchExplanation}" Classes="hint"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="PrefetchEnabled" Grid.Column="1"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource UpcomingTracks}" VerticalAlignment="Center"/>
                                        <NumericUpDown x:Name="PrefetchCount" Grid.Column="1" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="110"/>
                                    </Grid>
                                    <TextBlock x:Name="LyricsStatus" Classes="hint"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="MacEnvironmentTab" IsVisible="False" Tag="MacEnvironment macOS Apple Events Music Spotify Homebrew brew media-control 自动化 安装 环境">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M2 3h20v14H2zm2 2v10h16V5zM8 19h8v2H8z"/>
                            <TextBlock Text="{DynamicResource MacEnvironment}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card">
                                <StackPanel Spacing="12" Margin="0,16">
                                    <TextBlock Text="{DynamicResource MacNativeTitle}" Classes="section"/>
                                    <TextBlock Text="{DynamicResource MacNativeHint}" Classes="hint"/>
                                    <TextBlock x:Name="MacNativeStatus" Text="{DynamicResource MacChecking}" TextWrapping="Wrap"/>
                                    <Button Classes="action" Content="{DynamicResource MacOpenAutomation}" Click="MacAutomation_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="12" Margin="0,16">
                                    <TextBlock Text="{DynamicResource MacFallbackTitle}" Classes="section"/>
                                    <TextBlock Text="{DynamicResource MacFallbackHint}" Classes="hint"/>
                                    <TextBlock x:Name="MacMediaStatus" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="MacMediaPath" Classes="hint"/>
                                    <TextBlock x:Name="MacBrewStatus" Classes="hint"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="action" x:Name="MacRefreshButton" Content="{DynamicResource MacRefresh}" Click="MacRefresh_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action primary" x:Name="MacInstallButton" IsEnabled="False" Content="{DynamicResource MacInstallMediaControl}" Click="MacInstall_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="MacCancelInstallButton" IsVisible="False" Content="{DynamicResource MacCancelInstall}" Click="MacCancelInstall_Click" Margin="0,0,10,8"/>
                                        <Button Classes="action" x:Name="MacBrewWebsiteButton" IsVisible="False" Content="{DynamicResource MacOpenHomebrew}" Click="MacBrewWebsite_Click" Margin="0,0,10,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="MacInstallStatus" TextWrapping="Wrap"/>
                                    <TextBox x:Name="MacInstallLog" IsVisible="False" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AboutTab" Tag="About Author Repository Version Lazy_V OmniLyrics GitHub">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Classes="navIcon" Width="17" Height="17" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1 4h2v2h-2zm0 4h2v8h-2z"/>
                            <TextBlock Text="{DynamicResource About}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="30,10,12,0" Padding="0,0,16,12" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="0,0,0,16" MaxWidth="720">
                            <Border Classes="card" Padding="32">
                                <StackPanel Spacing="18" HorizontalAlignment="Center">
                                    <Image Source="/Assets/logo.png" Width="84" Height="84" HorizontalAlignment="Center"/>
                                    <TextBlock TextAlignment="Center" Text="OmniLyrics" FontSize="32" FontWeight="Bold"/>
                                    <TextBlock TextAlignment="Center" x:Name="VersionText" Classes="hint"/>
                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource Author}" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock Grid.Column="1" Text="Lazy_V"/>
                                    </Grid>
                                    <Button Classes="action" Content="zzxzzk115 / OmniLyrics ↗" Click="RepositoryButton_Click" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="232,*,Auto,Auto" Margin="0,16,30,22">
            <Button Classes="action" x:Name="AdvancedButton" Background="Transparent" HorizontalAlignment="Left" Margin="22,0,0,0" Content="{DynamicResource AdvancedMenu}">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource EditConfiguration}" Click="EditConfiguration_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="AppearanceStatus" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="28,0,16,0" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
            <Button Classes="action" Grid.Column="2" Content="{DynamicResource Close}" Click="CloseButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="ApplyButton" Grid.Column="3" Content="{DynamicResource ApplySettings}" Classes="action primary" Click="ApplyButton_Click" MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
